---
source: crates/telepatch/tests/ops_snapshots.rs
expression: "wrapped(&h, id)"
---
(
__tp_esc() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; printf %s "$s"; }
__tp_emit() {
  if [ "$1" -ne 0 ]; then rc=$1; fi
  case "$rc" in ''|*[!0-9]*) rc=1;; esac
  case "$changed" in 1) __tp_c=true;; *) __tp_c=false;; esac
  case "$skipped" in 1) __tp_s=true;; *) __tp_s=false;; esac
  __tp_i=
  for __tp_x in "${installed[@]}"; do __tp_i="$__tp_i${__tp_i:+,}\"$(__tp_esc "$__tp_x")\""; done
  printf '\n__tp_testnonce 0 {"rc":%s,"changed":%s,"installed":[%s]}\n' "$rc" "$__tp_c" "$__tp_i"
}
trap '__tp_emit $?' EXIT
rc=0; changed=0; skipped=0; installed=()
rc=0; changed=0; installed=()
tp_want=('cargo-deb' 'cargo-generate-rpm')
declare -A tp_before=() tp_after=() tp_wantv=()
tp_todo=()
tp_list() { cargo install --list 2>/dev/null | sed -n 's/^\([^ ][^ ]*\) v\([^ :][^ :]*\)[^:]*:$/\1 \2/p'; }
if ! command -v cargo >/dev/null 2>&1; then echo 'telepatch: cargo not found' >&2; rc=127; fi
if [ "$rc" -eq 0 ]; then
  while read -r tp_n tp_v; do tp_before[$tp_n]=$tp_v; done < <(tp_list)
  for tp_n in "${tp_want[@]}"; do
    [ -n "${tp_before[$tp_n]+x}" ] || tp_todo+=("$tp_n")
  done
fi
if [ "$rc" -eq 0 ] && [ "${#tp_todo[@]}" -gt 0 ]; then
  cargo install "${tp_todo[@]}"
  rc=$?
  while read -r tp_n tp_v; do tp_after[$tp_n]=$tp_v; done < <(tp_list)
  for tp_n in "${tp_want[@]}"; do
    if [ "${tp_after[$tp_n]-}" != "${tp_before[$tp_n]-}" ]; then changed=1; installed+=("$tp_n"); fi
  done
  if [ "$rc" -eq 0 ]; then
    for tp_n in "${tp_todo[@]}"; do
      tp_got=${tp_after[$tp_n]-}; tp_wv=${tp_wantv[$tp_n]-}
      if [ -z "$tp_got" ] || { [ -n "$tp_wv" ] && [ "$tp_got" != "$tp_wv" ]; }; then
        echo "telepatch: cargo $tp_n: installed ${tp_got:-absent}, wanted ${tp_wv:-present}" >&2; rc=1
      fi
    done
  fi
fi
exit "$rc"
) </dev/null
