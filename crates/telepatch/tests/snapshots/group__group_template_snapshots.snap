---
source: crates/telepatch/tests/group.rs
expression: "format!(\"{}\\n{}\", wrapped(&h, a), wrapped(&h, b))"
---
(
__tp_esc() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; printf %s "$s"; }
__tp_emit() {
  if [ "$1" -ne 0 ]; then rc=$1; fi
  case "$rc" in ''|*[!0-9]*) rc=1;; esac
  case "$changed" in 1) __tp_c=true;; *) __tp_c=false;; esac
  case "$skipped" in 1) __tp_s=true;; *) __tp_s=false;; esac
  __tp_i=
  for __tp_x in "${installed[@]}"; do __tp_i="$__tp_i${__tp_i:+,}\"$(__tp_esc "$__tp_x")\""; done
  case "$created" in 1) __tp_k=true;; *) __tp_k=false;; esac
  printf '\n__tp_t0n 0 {"rc":%s,"changed":%s,"created":%s}\n' "$rc" "$__tp_c" "$__tp_k"
}
trap '__tp_emit $?' EXIT
rc=0; changed=0; skipped=0; installed=()
created=0
tp_g='docker'
if ! getent group "$tp_g" >/dev/null 2>&1; then
  groupadd -- "$tp_g"
  rc=$?
  if [ "$rc" -eq 0 ]; then changed=1; created=1; fi
fi
exit "$rc"
) </dev/null

(
__tp_esc() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; printf %s "$s"; }
__tp_emit() {
  if [ "$1" -ne 0 ]; then rc=$1; fi
  case "$rc" in ''|*[!0-9]*) rc=1;; esac
  case "$changed" in 1) __tp_c=true;; *) __tp_c=false;; esac
  case "$skipped" in 1) __tp_s=true;; *) __tp_s=false;; esac
  __tp_i=
  for __tp_x in "${installed[@]}"; do __tp_i="$__tp_i${__tp_i:+,}\"$(__tp_esc "$__tp_x")\""; done
  case "$created" in 1) __tp_k=true;; *) __tp_k=false;; esac
  printf '\n__tp_t0n 1 {"rc":%s,"changed":%s,"created":%s}\n' "$rc" "$__tp_c" "$__tp_k"
}
trap '__tp_emit $?' EXIT
rc=0; changed=0; skipped=0; installed=()
created=0
tp_g='libvirt'
if ! getent group "$tp_g" >/dev/null 2>&1; then
  groupadd -r -- "$tp_g"
  rc=$?
  if [ "$rc" -eq 0 ]; then changed=1; created=1; fi
fi
exit "$rc"
) </dev/null
