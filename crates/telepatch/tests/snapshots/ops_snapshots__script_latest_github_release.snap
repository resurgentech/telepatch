---
source: crates/telepatch/tests/ops_snapshots.rs
expression: "wrapped(&h, p.id())"
---
(
__tp_esc() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; printf %s "$s"; }
__tp_emit() {
  if [ "$1" -ne 0 ]; then rc=$1; fi
  case "$rc" in ''|*[!0-9]*) rc=1;; esac
  case "$changed" in 1) __tp_c=true;; *) __tp_c=false;; esac
  case "$skipped" in 1) __tp_s=true;; *) __tp_s=false;; esac
  __tp_i=
  for __tp_x in "${installed[@]}"; do __tp_i="$__tp_i${__tp_i:+,}\"$(__tp_esc "$__tp_x")\""; done
  printf '\n__tp_testnonce 0 {"rc":%s,"changed":%s,"installed":[%s]}\n' "$rc" "$__tp_c" "$__tp_i"
}
trap '__tp_emit $?' EXIT
rc=0; changed=0; skipped=0; installed=()
rc=0; changed=0; installed=()
tp_name='uv'
tp_tok() { grep -oE '[0-9]+(\.[0-9A-Za-z+~-]+)*' | head -n1; }
tp_probe() {
  tp_have=0; tp_v=
  if [ -x '/usr/local/bin/uv' ]; then
    tp_have=1
    tp_v=$( (
uv self version --short
) 2>/dev/null | tp_tok)
  fi
}
tp_latest=$( (
if command -v curl >/dev/null 2>&1; then curl -fsSL -- 'https://api.github.com/repos/astral-sh/uv/releases/latest'; else wget -q -O - -- 'https://api.github.com/repos/astral-sh/uv/releases/latest'; fi | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"v\{0,1\}\([^"]*\)".*/\1/p' | head -n1
) 2>/dev/null | tp_tok)
tp_want_v=$tp_latest
if [ -z "$tp_want_v" ]; then echo "telepatch: script "'uv'": could not resolve the latest version" >&2; rc=1; fi
tp_probe
tp_had=$tp_have; tp_before=$tp_v; tp_act=
if [ "$rc" -eq 0 ]; then
  if [ "$tp_have" -eq 0 ]; then tp_act=install
  elif [ -n "$tp_want_v" ] && [ "$tp_v" != "$tp_want_v" ]; then tp_act=update
  fi
fi
if [ "$tp_act" = install ]; then
  ( export TP_WANT="$tp_want_v"
curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh
  )
  rc=$?
elif [ "$tp_act" = update ]; then
  ( export TP_WANT="$tp_want_v"
uv self update
  )
  rc=$?
fi
if [ -n "$tp_act" ]; then
  tp_probe
  if [ "$tp_have" -ne "$tp_had" ] || [ "$tp_v" != "$tp_before" ]; then changed=1; installed=("$tp_name"); fi
  if [ "$rc" -eq 0 ]; then
    if [ "$tp_have" -eq 0 ]; then tp_got=absent; else tp_got=${tp_v:-unknown}; fi
    if [ "$tp_have" -eq 0 ] || { [ -n "$tp_want_v" ] && [ "$tp_v" != "$tp_want_v" ]; }; then
      echo "telepatch: script $tp_name: installed $tp_got, wanted ${tp_want_v:-present}" >&2; rc=1
    fi
  fi
fi
exit "$rc"
) </dev/null
