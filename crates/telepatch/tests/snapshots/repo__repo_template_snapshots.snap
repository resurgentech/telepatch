  case "$skipped" in 1) __tp_s=true;; *) __tp_s=false;; esac
  __tp_i=
  for __tp_x in "${installed[@]}"; do __tp_i="$__tp_i${__tp_i:+,}\"$(__tp_esc "$__tp_x")\""; done
  case "${tp_kc-}" in 1) __tp_kc=true;; *) __tp_kc=false;; esac
  case "${tp_fc-}" in 1) __tp_k=true;; *) __tp_k=false;; esac
  printf '\n__tp_t0n 0 {"rc":%s,"changed":%s,"key_created":%s,"file_created":%s,"backup":"%s"}\n' "$rc" "$__tp_c" "$__tp_kc" "$__tp_k" "$(__tp_esc "${tp_bk-}")"
