---
source: crates/telepatch/tests/repo.rs
expression: "format!(\"{}\\n{}\\n{}\", wrapped_display(&h, a), wrapped_display(&f, b),\nwrapped_display(&f, c))"
---
{ (
exec 2>&3 3>&-
__tp_esc() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; printf %s "$s"; }
__tp_emit() {
  if [ "$1" -ne 0 ]; then rc=$1; fi
  case "$rc" in ''|*[!0-9]*) rc=1;; esac
  case "$changed" in 1) __tp_c=true;; *) __tp_c=false;; esac
  case "$skipped" in 1) __tp_s=true;; *) __tp_s=false;; esac
  __tp_i=
  for __tp_x in "${installed[@]}"; do __tp_i="$__tp_i${__tp_i:+,}\"$(__tp_esc "$__tp_x")\""; done
  case "${tp_kc-}" in 1) __tp_kc=true;; *) __tp_kc=false;; esac
  case "${tp_fc-}" in 1) __tp_k=true;; *) __tp_k=false;; esac
  printf '\n__tp_t0n 0 {"rc":%s,"changed":%s,"key_created":%s,"file_created":%s,"backup":"%s"}\n' "$rc" "$__tp_c" "$__tp_kc" "$__tp_k" "$(__tp_esc "${tp_bk-}")"
}
trap '__tp_emit $?' EXIT
trap 'exit 143' TERM
rc=0; changed=0; skipped=0; installed=()
tp_id=0
printf '\n__tpS_t0n 0 %s %s\n' "$BASHPID" "$$"
[ "${__tp_hv-}" = fe76955f7a14ddf7 ] && declare -F tp_save >/dev/null || { echo "telepatch: shell helpers missing or stale (want fe76955f7a14ddf7)" >&2; exit 125; }
tp_n='docker'
tp_fetch() {
  if ! command -v curl >/dev/null 2>&1; then
    echo "telepatch: repo $tp_n: curl not found" >&2
    return 1
  fi
  (umask 022; mkdir -p -- "$(dirname -- "$2")") || return 1
  tp_t=$(mktemp "$2.XXXXXX") || return 1
  if curl -fsSL -o "$tp_t" --url "$1" && chmod 0644 "$tp_t" && mv -f -- "$tp_t" "$2"; then
    return 0
  fi
  rm -f -- "$tp_t"
  return 1
}
tp_put() {
  if [ -f "$1" ] && [ "$(tp_render "$2" | sha256sum | cut -d' ' -f1)" = "$(sha256sum < "$1" | cut -d' ' -f1)" ]; then return 0; fi
  tp_new=
  if [ -e "$1" ] || [ -L "$1" ]; then tp_was "$1"; tp_save "$1" || return 1; else tp_new=1; fi
  (umask 022; mkdir -p -- "$(dirname -- "$1")") || return 1
  tp_t=$(mktemp "$1.XXXXXX") || return 1
  if tp_render "$2" > "$tp_t" && chmod 0644 "$tp_t" && mv -f -- "$tp_t" "$1"; then
    changed=1
    [ -z "$tp_new" ] || tp_fc=1
    return 0
  fi
  rm -f -- "$tp_t"
  return 1
}
tp_render() { printf 'Types: deb\nURIs: %s\nSuites: %s\nComponents: %s\nArchitectures: %s\nSigned-By: %s\n' 'https://download.docker.com/linux/ubuntu' 'noble' 'stable' "$1" '/etc/apt/keyrings/docker.asc'; }
tp_key='/etc/apt/keyrings/docker.asc'
tp_src='/etc/apt/sources.list.d/docker.sources'
if [ ! -e "$tp_key" ]; then
  if tp_fetch 'https://download.docker.com/linux/ubuntu/gpg' "$tp_key"; then changed=1; tp_kc=1; else rc=1; fi
fi
if [ "$rc" -eq 0 ]; then
  tp_arch=$(dpkg --print-architecture)
  if [ -z "$tp_arch" ]; then
    echo "telepatch: repo $tp_n: cannot read the dpkg architecture" >&2
    rc=1
  elif ! tp_put "$tp_src" "$tp_arch"; then
    rc=1
  fi
fi
exit "$rc"
) </dev/null; } 3>&2 2>/dev/null

{ (
exec 2>&3 3>&-
__tp_esc() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; printf %s "$s"; }
__tp_emit() {
  if [ "$1" -ne 0 ]; then rc=$1; fi
  case "$rc" in ''|*[!0-9]*) rc=1;; esac
