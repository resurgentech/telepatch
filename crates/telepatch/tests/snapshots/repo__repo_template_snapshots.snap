  (umask 022; mkdir -p -- "$(dirname -- "$2")") || return 1
  tp_t=$(mktemp "$2.XXXXXX") || return 1
  if curl -fsSL -o "$tp_t" --url "$1" && chmod 0644 "$tp_t" && mv -f -- "$tp_t" "$2"; then
    return 0
  fi
  rm -f -- "$tp_t"
  return 1
}
tp_f='/etc/yum.repos.d/docker.repo'
if [ ! -e "$tp_f" ]; then
  if tp_fetch 'https://download.docker.com/linux/rhel/docker-ce.repo' "$tp_f"; then changed=1; tp_fc=1; else rc=1; fi
fi
exit "$rc"
) </dev/null; } 3>&2 2>/dev/null

