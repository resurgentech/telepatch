---
source: crates/telepatch/tests/svc.rs
expression: "render_host(\"h\", &h.os, &h.snapshot())"
---
host h (os: Debian/Debian 12)
blocking reads: 0

role (none)
  #0 svc as shell:root reads [] writes [svc:bluetooth.service] post [svc:bluetooth.service=Exists(true)]
      | tp_u='bluetooth'
      | tp_run="${TP_SVC_RUNDIR:-/run/systemd/system}"
      | tp_skip=0
      | if ! command -v systemctl >/dev/null 2>&1; then
      |   skipped=1
      | else
      |   if [ "$rc" -eq 0 ]; then
      |     if [ -d "$tp_run" ]; then
      |       if systemctl is-active --quiet -- "$tp_u"; then
      |         systemctl stop -- "$tp_u"
      |         rc=$?
      |         if [ "$rc" -eq 0 ]; then changed=1; fi
      |       fi
      |     else
      |       tp_skip=1
      |     fi
      |   fi
      |   if [ "$rc" -eq 0 ]; then
      |     case "$(systemctl is-enabled -- "$tp_u" 2>/dev/null)" in
      |       enabled|enabled-runtime)
      |         systemctl disable -- "$tp_u"
      |         rc=$?
      |         if [ "$rc" -eq 0 ]; then changed=1; fi
      |         ;;
      |     esac
      |   fi
      |   if [ "$rc" -eq 0 ] && [ "$changed" -eq 0 ] && [ "$tp_skip" -eq 1 ]; then skipped=1; fi
      | fi
  #1 svc as shell:root reads [] writes [svc:wait-online.service] post [svc:wait-online.service=Exists(true)]
      | tp_u='wait-online'
      | tp_run="${TP_SVC_RUNDIR:-/run/systemd/system}"
      | tp_skip=0
      | if ! command -v systemctl >/dev/null 2>&1; then
      |   skipped=1
      | else
      |   if [ "$rc" -eq 0 ]; then
      |     case "$(systemctl is-enabled -- "$tp_u" 2>/dev/null)" in
      |       masked|masked-runtime) ;;
      |       *)
      |         systemctl mask -- "$tp_u"
      |         rc=$?
      |         if [ "$rc" -eq 0 ]; then changed=1; fi
      |         ;;
      |     esac
      |   fi
      | fi
