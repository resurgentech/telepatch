---
source: crates/telepatch/tests/ops_snapshots.rs
expression: "telepatch::testing::plan(&telepatch::Playbook { name: \"t\", run: two_rustups },\n&fx)"
---
host h (os: Debian/Debian 12)
blocking reads: 0

window 1 (final)
role a
  #1 pkg[rustup] as shell:root reads [] writes [*] post [pkg:rustup:root:stable=Installed, pkg:rustup:root:stable/component/clippy=Installed, pkg:rustup:root:stable/component/rust-src=Installed, pkg:rustup:root:stable/target/wasm32-unknown-unknown=Installed, pkg:rustup:root:stable/target/x86_64-unknown-linux-musl=Installed]
      | rc=0; changed=0; installed=()
      | tp_tc='stable'
      | tp_prof='default'
      | tp_path() {
      |   tp_cb=${CARGO_HOME:-$HOME/.cargo}/bin
      |   if [ -d "$tp_cb" ]; then case ":$PATH:" in *":$tp_cb:"*) ;; *) PATH=$tp_cb:$PATH;; esac; fi
      | }
      | tp_match() { awk -v t="$1" 'function tcm(f, t) { return f == t || (index(f, t "-") == 1 && substr(f, length(t) + 2) ~ /^(x86_64|i[3-6]86|aarch64|arm[0-9a-z_]*|riscv[0-9a-z]*|powerpc[0-9a-z_]*|s390x|loongarch64|mips[0-9a-z_]*|sparc[0-9a-z_]*|thumb[0-9a-z_]*|wasm[0-9]+)-[a-z0-9_]+-[a-z]/) } { if (tcm($1, t)) m=1 } END { exit m ? 0 : 1 }'; }
      | tp_ver() { rustup run "$tp_tc" rustc --version 2>/dev/null | grep -oE '[0-9]+(\.[0-9A-Za-z+~-]+)*' | head -n1; }
      | tp_has_tc() { rustup toolchain list 2>/dev/null | tp_match "$tp_tc"; }
      | tp_updates() { awk -v t="$tp_tc" 'function tcm(f, t) { return f == t || (index(f, t "-") == 1 && substr(f, length(t) + 2) ~ /^(x86_64|i[3-6]86|aarch64|arm[0-9a-z_]*|riscv[0-9a-z]*|powerpc[0-9a-z_]*|s390x|loongarch64|mips[0-9a-z_]*|sparc[0-9a-z_]*|thumb[0-9a-z_]*|wasm[0-9]+)-[a-z0-9_]+-[a-z]/) } /[Uu]pdate available/ { if ($1 == "rustup") print "self"; else if (tcm($1, t)) { v=$0; sub(/.*-> */, "", v); split(v, a, " "); print "tc " a[1] } }'; }
      | tp_check() { tp_chk=$(rustup check 2>&1); tp_crc=$?; [ "$tp_crc" -eq 0 ] || [ "$tp_crc" -eq 100 ]; }
      | tp_path
      | tp_fresh=0
      | if ! command -v rustup >/dev/null 2>&1; then
      |   ( set -o pipefail; curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain "$tp_tc" --profile "$tp_prof" )
      |   rc=$?
      |   tp_path
      |   if [ "$rc" -eq 0 ] && ! command -v rustup >/dev/null 2>&1; then echo 'telepatch: rustup not found after the installer' >&2; rc=1; fi
      |   if [ "$rc" -eq 0 ]; then tp_fresh=1; fi
      | elif ! tp_has_tc; then
      |   rustup toolchain install "$tp_tc" --profile "$tp_prof"
      |   rc=$?
      |   if [ "$rc" -eq 0 ]; then tp_fresh=1; fi
      | fi
      | if [ "$tp_fresh" -eq 1 ]; then
      |   if tp_has_tc; then changed=1; installed+=("$tp_tc"); else echo "telepatch: rustup toolchain $tp_tc: not installed afterwards" >&2; rc=1; fi
      | fi
      | if [ "$rc" -eq 0 ] && ! rustup default 2>/dev/null | tp_match "$tp_tc"; then
      |   rustup default "$tp_tc"
      |   rc=$?
      |   if [ "$rc" -eq 0 ]; then changed=1; fi
      | fi
      | if [ "$rc" -eq 0 ]; then
      |   tp_have=$(rustup target list --installed --toolchain "$tp_tc" 2>/dev/null)
      |   tp_miss=()
      |   for tp_x in 'x86_64-unknown-linux-musl' 'wasm32-unknown-unknown'; do
      |     printf '%s\n' "$tp_have" | grep -qxF -- "$tp_x" || tp_miss+=("$tp_x")
      |   done
      |   if [ "${#tp_miss[@]}" -gt 0 ]; then
      |     rustup target add --toolchain "$tp_tc" "${tp_miss[@]}"
      |     rc=$?
      |     if [ "$rc" -eq 0 ]; then
      |       changed=1
      |       for tp_x in "${tp_miss[@]}"; do installed+=("$tp_tc/target/$tp_x"); done
      |     fi
      |   fi
      | fi
      | if [ "$rc" -eq 0 ]; then
      |   tp_have=$(rustup component list --installed --toolchain "$tp_tc" 2>/dev/null)
      |   tp_miss=()
      |   for tp_x in 'clippy' 'rust-src'; do
      |     printf '%s\n' "$tp_have" | tp_match "$tp_x" || tp_miss+=("$tp_x")
      |   done
      |   if [ "${#tp_miss[@]}" -gt 0 ]; then
      |     rustup component add --toolchain "$tp_tc" "${tp_miss[@]}"
      |     rc=$?
      |     if [ "$rc" -eq 0 ]; then
      |       changed=1
      |       for tp_x in "${tp_miss[@]}"; do installed+=("$tp_tc/component/$tp_x"); done
      |     fi
      |   fi
      | fi
      merged from a #1, b #4
