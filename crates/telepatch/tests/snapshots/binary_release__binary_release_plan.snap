---
source: crates/telepatch/tests/binary_release.rs
expression: plan
---
host debian12 (os: Debian/Debian 12)
blocking reads: 0

window 1 (final)
role (none)
  #0 pkg[binary_release] as shell:root reads [] writes [*] post [pkg:binary_release:root:go=Installed, file:/usr/local/go/bin/go=Exists(true)]
      | rc=0; changed=0; installed=()
      | tp_name='go'
      | tp_cd="${TP_FETCH_CACHE:-/var/cache/telepatch/sha256}"
      | tp_sd="${TP_FETCH_STAGE:-/var/tmp/telepatch}"
      | tp_run="$tp_sd"/"$__tp_run"
      | tp_dec="$tp_run/br-$(printf %s "$tp_name" | sha256sum | cut -c1-32)"
      | tp_tok() { grep -oE '[0-9]+(\.[0-9A-Za-z+~-]+)*' | head -n1; }
      | if [ -f "$tp_dec" ]; then
      | read -r tp_s tp_want tp_f < "$tp_dec"
      | rm -f -- "$tp_dec"
      | if [ ! -f "$tp_f" ]; then echo "telepatch: binary_release $tp_name: $tp_f is missing (prepare did not fetch it)" >&2; rc=1; fi
      | tp_p='/usr/local/go'
      | if [ "$rc" -eq 0 ]; then mkdir -p -- "$(dirname -- "$tp_p")" || rc=$?; fi
      | tp_magic() {
      |   local h
      |   h=$(head -c 6 "$1" | od -An -tx1 | tr -d ' \n')
      |   case "$h" in
      |     1f8b*) echo gz;;
      |     fd377a585a00) echo xz;;
      |     28b52ffd*) echo zst;;
      |     504b0304*|504b0506*) echo zip;;
      |     *) if [ "$(dd if="$1" bs=1 skip=257 count=5 2>/dev/null)" = ustar ]; then echo tar; else echo unknown; fi;;
      |   esac
      | }
      | tp_n=
      | if [ "$rc" -eq 0 ]; then
      |   tp_k=$(tp_magic "$tp_f")
      |   tp_mk="$tp_s strip=1"
      |   if [ -e "$tp_p" ] && [ ! -d "$tp_p" ]; then
      |     echo "telepatch: $tp_p exists and is not a directory" >&2; rc=1
      |   elif [ -d "$tp_p" ] && [ "$(cat "$tp_p/.telepatch-fetch" 2>/dev/null)" = "$tp_mk" ]; then
      |     :
      |   else
      |     tp_n=$(mktemp -d "$tp_p.tpXXXXXX") || rc=$?
      |     if [ "$rc" -eq 0 ]; then
      |       case "$tp_k" in
      |         zip)
      |           tp_z="$tp_n.raw"
      |           mkdir "$tp_z" || rc=$?
      |           if [ "$rc" -eq 0 ]; then
      |             if command -v unzip >/dev/null 2>&1; then unzip -q -o "$tp_f" -d "$tp_z" || rc=$?; else bsdtar -xf "$tp_f" -C "$tp_z" || rc=$?; fi
      |           fi
      |           if [ "$rc" -eq 0 ]; then
      |             find "$tp_z" -mindepth 1 -maxdepth 1 -type d -print0 | while IFS= read -r -d '' tp_d; do cp -a "$tp_d"/. "$tp_n"/ || exit 1; done
      |             rc=${PIPESTATUS[1]}
      |           fi
      |           rm -rf "$tp_z";;
      |         gz|xz|zst|tar) tar -xf "$tp_f" -C "$tp_n" --strip-components=1 --no-same-owner || rc=$?;;
      |         *) echo "telepatch: $tp_f is not a tar or zip archive" >&2; rc=1;;
      |       esac
      |     fi
      |     if [ "$rc" -eq 0 ]; then printf '%s\n' "$tp_mk" > "$tp_n/.telepatch-fetch" || rc=$?; fi
      |     if [ "$rc" -eq 0 ]; then
      |       if [ -d "$tp_p" ]; then chmod --reference="$tp_p" "$tp_n" || rc=$?; else chmod 755 "$tp_n" || rc=$?; fi
      |     fi
      |     if [ "$rc" -eq 0 ] && [ -d "$tp_p" ]; then chown --reference="$tp_p" "$tp_n" 2>/dev/null; fi
      |     if [ "$rc" -eq 0 ]; then
      |       if [ -d "$tp_p" ]; then
      |         tp_o="$tp_n.old"
      |         if mv -- "$tp_p" "$tp_o" && mv -- "$tp_n" "$tp_p"; then
      |           rm -rf -- "$tp_o"; changed=1
      |         else
      |           rc=$?
      |           if [ ! -e "$tp_p" ]; then mv -- "$tp_o" "$tp_p"; fi
      |         fi
      |       elif mv -- "$tp_n" "$tp_p"; then
      |         changed=1
      |       else
      |         rc=$?
      |       fi
      |     fi
      |     if [ -n "$tp_n" ]; then rm -rf -- "$tp_n" "$tp_n.raw"; fi
      |   fi
      | fi
      | case "$tp_f" in "$tp_run"/*) rm -f -- "$tp_f";; esac
      | rmdir -- "$tp_run" 2>/dev/null
      | if [ "$rc" -eq 0 ] && [ ! -x '/usr/local/go/bin/go' ]; then echo "telepatch: binary_release $tp_name: "'/usr/local/go/bin/go'" is not an executable after the install" >&2; rc=1; fi
      | if [ "$rc" -eq 0 ] && [ "$tp_want" != - ]; then
      |   tp_bd=$(dirname -- '/usr/local/go/bin/go')
      |   tp_v=$( ( PATH="$tp_bd:$PATH"
      | go version
      | ) 2>/dev/null </dev/null | tp_tok)
      |   if [ "$tp_v" != "$tp_want" ]; then echo "telepatch: binary_release $tp_name: installed ${tp_v:-unknown}, wanted $tp_want" >&2; rc=1; fi
      | fi
      | if [ "$changed" = 1 ]; then installed=("$tp_name"); fi
      | fi
  #1 file as shell:root reads [] writes [file:/opt/tool/tool.bin] post [file:/opt/tool/tool.bin=Exists(true)]
      allowed unverified: the test server publishes no sums
      | rc=0; changed=0
      | tp_p='/opt/tool/tool.bin'
      | tp_fsroot() {
      |   local d=$1 r s= q v a; case $d in /*) ;; *) d=$PWD/$d;; esac
      |   IFS=: read -ra a <<<"${TP_FS_ROOTS-}"
      |   for r in "${a[@]}"; do r=${r%/}; [ -n "$r" ] || continue; case "$d/" in "$r"/*) [ ${#r} -gt ${#s} ] && s=$r;; esac; done
      |   if [ -n "$s" ]; then printf %s "$s"; return; fi
      |   while [ ! -e "$d" ] && [ ! -L "$d" ]; do d=$(dirname -- "$d"); done
      |   v=$(stat -c %d -- "$d")
      |   while q=$(dirname -- "$d"); [ "$q" != "$d" ] && [ "$(stat -c %d -- "$q")" = "$v" ]; do d=$q; done
      |   printf %s "$d"
      | }
      | tp_was() {
      |   if [ -L "$1" ]; then tp_wt=symlink; elif [ -d "$1" ]; then tp_wt=dir; elif [ -e "$1" ]; then tp_wt=file; else return 0; fi
      |   tp_ex=1; tp_wm=$(stat -c %a -- "$1"); tp_wo=$(stat -c %U:%G -- "$1")
      | }
      | tp_try() { local p=$1 w=$2 e; shift 2; e=$("$@" 2>&1) || { echo "telepatch: file $p: cannot save undo data: $w: ${e##*: }" >&2; return 1; }; }
      | tp_mkd() { [ -d "$2" ] || tp_try "$tp_up" "$2" mkdir -m "$1" -- "$2"; }
      | tp_idx() { grep -qxF -- "$1" "$2" 2>/dev/null || (umask 077; printf '%s\n' "$1" >> "$2"); }
      | tp_undo() {
      |   tp_bd=; tp_bk=; [ -n "${__tp_run-}" ] || return 0
      |   local sd=${TP_FETCH_STAGE:-/var/tmp/telepatch} u r s t i n=
      |   tp_up=$1; u=$(id -un); r=$(tp_fsroot "$1"); s=$sd/$__tp_run; t=$r/.telepatch/tmp/$__tp_run
      |   [ -d "$r" ] || { echo "telepatch: file $1: is a mount point" >&2; return 1; }
      |   if [ "$r" != "$(tp_fsroot "$sd")" ] && [ ! -d "$t/undo/$u" ]; then
      |     case ":${TP_FS_ROOTS-}:" in *":$r:"*) ;; *) [ "$(id -u)" = 0 ] || { echo "telepatch: file $1: cannot save undo data: $t/undo/$u: not prepared" >&2; return 1; };; esac
      |   fi
      |   tp_try "$1" "$s/undo" mkdir -p -m 711 -- "$s/undo" && tp_mkd 700 "$s/undo/$u" || return 1
      |   tp_bk=$s/undo/$u/$tp_id
      |   if [ "$r" = "$(tp_fsroot "$sd")" ]; then tp_bd=$tp_bk
      |   else
      |     if [ ! -d "$t/undo/$u" ]; then
      |       [ -d "$t" ] || n=1
      |       for i in "$r/.telepatch" "$r/.telepatch/tmp" "$t" "$t/undo"; do
      |         tp_mkd 711 "$i" || return 1
      |         if [ "$i" = "$t" ] && [ -n "$n" ]; then tp_try "$1" "$s/fsroots" tp_idx "$r" "$s/fsroots" || return 1; fi
      |       done
      |       tp_mkd 700 "$t/undo/$u" || return 1
      |     fi
      |     tp_bd=$t/undo/$u/$tp_id
      |   fi
      |   tp_try "$1" "$tp_bd" mkdir -p -m 700 -- "$tp_bd" || return 1
      |   [ "$tp_bd" = "$tp_bk" ] || tp_try "$1" "$tp_bk" ln -sfn -- "$tp_bd" "$tp_bk"
      | }
      | tp_save() {
      |   [ "${tp_ex-}" = 1 ] && [ -z "${tp_sv-}" ] || return 0; tp_sv=1
      |   tp_undo "$1" && { [ -z "$tp_bd" ] || tp_try "$1" "$tp_bd/old" cp -a${2:+L} -- "$1" "$tp_bd/old"; } || { tp_bk=; return 1; }
      | }
      | tp_mnt() {
      |   local p=${1%/} r a; IFS=: read -ra a <<<"${TP_FS_ROOTS-}"
      |   for r in "${a[@]}"; do [ "${r%/}" = "$p" ] && return 0; done
      |   [ ! -L "$p" ] && [ -e "$p" ] && [ "$(stat -c %d -- "$p")" != "$(stat -c %d -- "$(dirname -- "$p")")" ]
      | }
      | tp_nest() {
      |   local p=${1%/} r a; IFS=: read -ra a <<<"${TP_FS_ROOTS-}"
      |   for r in "${a[@]}"; do r=${r%/}; case "$r/" in "$p"/?*) printf %s "$r"; return 0;; esac; done
      |   [ -d "$p" ] && [ ! -L "$p" ] || return 1
      |   r=$(find "$p" -mindepth 1 -type d -printf '%D %p\n' 2>/dev/null | awk -v d="$(stat -c %d -- "$p")" '$1 != d { sub(/^[^ ]* /, ""); print; exit }')
      |   [ -n "$r" ] && printf %s "$r"
      | }
      | tp_gate() {
      |   local m
      |   if tp_mnt "$1"; then echo "telepatch: file $1: is a mount point" >&2; return 1; fi
      |   if m=$(tp_nest "$1"); then echo "telepatch: file $1: a filesystem is mounted under it ($m)" >&2; return 1; fi
      |   [ -n "${2-}" ] && return 0
      |   tp_undo "$1" || { tp_bk=; return 1; }
      | }
      | tp_mk() {
      |   local x=$1; tp_cx=
      |   while [ ! -e "$x" ] && [ ! -L "$x" ]; do tp_cx=$x; x=$(dirname -- "$x"); done
      |   (umask 022; mkdir -p -- "$1")
      | }
      | tp_open() { [ -n "${tp_og-}" ] || { tp_undo "$tp_p" && tp_og=1 || { tp_bk=; return 1; }; }; }
      | tp_note() { [ -z "$tp_bd" ] || tp_try "$tp_p" "$tp_bd/created" tp_idx "$1 $2" "$tp_bd/created"; }
      | tp_cp() {
      |   tp_open || return 1; [ -z "$tp_bd" ] && return 0
      |   tp_try "$tp_p" "$tp_bd/old/$2" mkdir -p -- "$(dirname -- "$tp_bd/old/$2")" && tp_try "$tp_p" "$tp_bd/old/$2" cp -a -- "$1" "$tp_bd/old/$2"
      | }
      | tp_was "$tp_p"
      | tp_cd="${TP_FETCH_CACHE:-/var/cache/telepatch/sha256}"
      | tp_sd="${TP_FETCH_STAGE:-/var/tmp/telepatch}"
      | tp_f="$tp_sd"/"$__tp_run"/"u-$(printf %s 'https://example.invalid/tool.tar.gz' | sha256sum | cut -c1-32)"
      | if [ ! -f "$tp_f" ]; then echo "telepatch: fetched file $tp_f is missing (prepare did not fetch it)" >&2; rc=1; fi
      | if [ "$rc" -eq 0 ]; then tp_s=$(sha256sum "$tp_f" | cut -d' ' -f1); fi
      | if [ "$rc" -eq 0 ] && [ -d "$tp_p" ]; then echo "telepatch: $tp_p is a directory" >&2; rc=1; fi
      | if [ "$rc" -eq 0 ] && ! { [ -f "$tp_p" ] && [ "$(sha256sum < "$tp_p" | cut -d' ' -f1)" = "$tp_s" ]; }; then
      |   tp_t=$(mktemp "$tp_p.tpXXXXXX") || rc=$?
      |   if [ "$rc" -eq 0 ]; then
      |     cp -- "$tp_f" "$tp_t" || rc=$?
      |     if [ "$rc" -eq 0 ]; then
      |       if [ -e "$tp_p" ]; then chmod --reference="$tp_p" "$tp_t" || rc=$?; else chmod 644 "$tp_t" || rc=$?; fi
      |     fi
      |     if [ "$rc" -eq 0 ] && [ -e "$tp_p" ]; then chown --reference="$tp_p" "$tp_t" 2>/dev/null; fi
      |     if [ "$rc" -eq 0 ]; then tp_save "$tp_p" && mv -f "$tp_t" "$tp_p"; rc=$?; fi
      |     if [ "$rc" -eq 0 ]; then changed=1; else rm -f "$tp_t"; fi
      |   fi
      | fi
