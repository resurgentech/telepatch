---
source: crates/telepatch/tests/ops_snapshots.rs
expression: "format!(\"{}\\n{}\", wrapped(&h, a.id()), wrapped(&h, b.id()))"
---
{ (
exec 2>&3 3>&-
__tp_esc() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; printf %s "$s"; }
__tp_emit() {
  if [ "$1" -ne 0 ]; then rc=$1; fi
  case "$rc" in ''|*[!0-9]*) rc=1;; esac
  case "$changed" in 1) __tp_c=true;; *) __tp_c=false;; esac
  case "$skipped" in 1) __tp_s=true;; *) __tp_s=false;; esac
  __tp_i=
  for __tp_x in "${installed[@]}"; do __tp_i="$__tp_i${__tp_i:+,}\"$(__tp_esc "$__tp_x")\""; done
  printf '\n__tp_testnonce 0 {"rc":%s,"changed":%s,"installed":[%s]}\n' "$rc" "$__tp_c" "$__tp_i"
}
trap '__tp_emit $?' EXIT
trap 'exit 143' TERM
rc=0; changed=0; skipped=0; installed=()
printf '\n__tpS_testnonce 0 %s %s\n' "$BASHPID" "$$"
rc=0; changed=0; installed=()
tp_want=('git')
tp_missing=()
tp_pin='2.40.1-1.amzn2023.0.3'
tp_up=()
tp_have() { rpm -q --qf '%{VERSION}\n%{VERSION}-%{RELEASE}\n%|EPOCH?{%{EPOCH}:%{VERSION}-%{RELEASE}\n}|' "$1" 2>/dev/null | grep -qxF -- "$tp_pin"; }
for tp_n in "${tp_want[@]}"; do
  tp_have "$tp_n" || tp_missing+=("$tp_n")
done
for tp_n in "${tp_missing[@]}"; do
  yum install -y "$tp_n-$tp_pin"
  rc=$?
  if [ "$rc" -eq 0 ] && ! tp_have "$tp_n"; then yum downgrade -y "$tp_n-$tp_pin"; rc=$?; fi
  [ "$rc" -eq 0 ] || break
done
if [ "$rc" -eq 0 ] && [ "${#tp_missing[@]}" -gt 0 ]; then changed=1; installed=("${tp_missing[@]}"); fi
exit "$rc"
) </dev/null; } 3>&2 2>/dev/null

{ (
exec 2>&3 3>&-
__tp_esc() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; printf %s "$s"; }
__tp_emit() {
  if [ "$1" -ne 0 ]; then rc=$1; fi
  case "$rc" in ''|*[!0-9]*) rc=1;; esac
  case "$changed" in 1) __tp_c=true;; *) __tp_c=false;; esac
  case "$skipped" in 1) __tp_s=true;; *) __tp_s=false;; esac
  __tp_i=
  for __tp_x in "${installed[@]}"; do __tp_i="$__tp_i${__tp_i:+,}\"$(__tp_esc "$__tp_x")\""; done
  printf '\n__tp_testnonce 1 {"rc":%s,"changed":%s,"installed":[%s]}\n' "$rc" "$__tp_c" "$__tp_i"
}
trap '__tp_emit $?' EXIT
trap 'exit 143' TERM
rc=0; changed=0; skipped=0; installed=()
printf '\n__tpS_testnonce 1 %s %s\n' "$BASHPID" "$$"
rc=0; changed=0; installed=()
tp_want=('jq')
tp_missing=()
tp_up=()
for tp_n in "${tp_want[@]}"; do
  if rpm -q "$tp_n" >/dev/null 2>&1; then
    yum -q check-update "$tp_n" >/dev/null 2>&1
    if [ $? -eq 100 ]; then tp_up+=("$tp_n"); fi
  else tp_missing+=("$tp_n"); fi
done
if [ "${#tp_missing[@]}" -gt 0 ]; then
  yum install -y "${tp_missing[@]}"
  rc=$?
  if [ "$rc" -eq 0 ]; then changed=1; installed+=("${tp_missing[@]}"); fi
fi
if [ "$rc" -eq 0 ] && [ "${#tp_up[@]}" -gt 0 ]; then
  yum upgrade -y "${tp_up[@]}"
  rc=$?
  if [ "$rc" -eq 0 ]; then changed=1; installed+=("${tp_up[@]}"); fi
fi
exit "$rc"
) </dev/null; } 3>&2 2>/dev/null
