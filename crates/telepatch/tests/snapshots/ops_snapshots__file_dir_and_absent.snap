---
source: crates/telepatch/tests/ops_snapshots.rs
expression: "format!(\"{}\\n{}\", wrapped(&h, d), wrapped(&h, a))"
---
{ (
exec 2>&3 3>&-
__tp_esc() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; printf %s "$s"; }
__tp_emit() {
  if [ "$1" -ne 0 ]; then rc=$1; fi
  case "$rc" in ''|*[!0-9]*) rc=1;; esac
  case "$changed" in 1) __tp_c=true;; *) __tp_c=false;; esac
  case "$skipped" in 1) __tp_s=true;; *) __tp_s=false;; esac
  __tp_i=
  for __tp_x in "${installed[@]}"; do __tp_i="$__tp_i${__tp_i:+,}\"$(__tp_esc "$__tp_x")\""; done
  case "${tp_ex-}" in 1) __tp_ex=true;; *) __tp_ex=false;; esac
  printf '\n__tp_testnonce 0 {"rc":%s,"changed":%s,"existed":%s,"was_type":"%s","was_mode":"%s","was_owner":"%s","created_top":"%s","backup":"%s"}\n' "$rc" "$__tp_c" "$__tp_ex" "$(__tp_esc "${tp_wt-}")" "$(__tp_esc "${tp_wm-}")" "$(__tp_esc "${tp_wo-}")" "$(__tp_esc "${tp_ct-}")" "$(__tp_esc "${tp_bk-}")"
}
trap '__tp_emit $?' EXIT
trap 'exit 143' TERM
rc=0; changed=0; skipped=0; installed=()
tp_id=0
printf '\n__tpS_testnonce 0 %s %s\n' "$BASHPID" "$$"
[ "${__tp_hv-}" = fe76955f7a14ddf7 ] && declare -F tp_save >/dev/null || { echo "telepatch: shell helpers missing or stale (want fe76955f7a14ddf7)" >&2; exit 125; }
rc=0; changed=0
tp_p='/opt/x'
tp_was "$tp_p"
if [ -d "$tp_p" ]; then :
elif [ -e "$tp_p" ] || [ -L "$tp_p" ]; then
  echo "telepatch: $tp_p exists and is not a directory" >&2; rc=1
else
  tp_mk "$tp_p"
  rc=$?
  if [ "$rc" -eq 0 ]; then changed=1; tp_ct=$tp_cx; fi
fi
if [ "$rc" -eq 0 ] && [ "$(stat -L -c %a "$tp_p")" != '755' ]; then
  if chmod 755 "$tp_p"; then changed=1; else rc=$?; fi
fi
exit "$rc"
) </dev/null; } 3>&2 2>/dev/null

{ (
exec 2>&3 3>&-
__tp_esc() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; printf %s "$s"; }
__tp_emit() {
  if [ "$1" -ne 0 ]; then rc=$1; fi
  case "$rc" in ''|*[!0-9]*) rc=1;; esac
  case "$changed" in 1) __tp_c=true;; *) __tp_c=false;; esac
  case "$skipped" in 1) __tp_s=true;; *) __tp_s=false;; esac
  __tp_i=
  for __tp_x in "${installed[@]}"; do __tp_i="$__tp_i${__tp_i:+,}\"$(__tp_esc "$__tp_x")\""; done
  case "${tp_ex-}" in 1) __tp_ex=true;; *) __tp_ex=false;; esac
  printf '\n__tp_testnonce 1 {"rc":%s,"changed":%s,"existed":%s,"was_type":"%s","was_mode":"%s","was_owner":"%s","created_top":"%s","backup":"%s"}\n' "$rc" "$__tp_c" "$__tp_ex" "$(__tp_esc "${tp_wt-}")" "$(__tp_esc "${tp_wm-}")" "$(__tp_esc "${tp_wo-}")" "$(__tp_esc "${tp_ct-}")" "$(__tp_esc "${tp_bk-}")"
}
trap '__tp_emit $?' EXIT
trap 'exit 143' TERM
rc=0; changed=0; skipped=0; installed=()
tp_id=1
printf '\n__tpS_testnonce 1 %s %s\n' "$BASHPID" "$$"
[ "${__tp_hv-}" = fe76955f7a14ddf7 ] && declare -F tp_save >/dev/null || { echo "telepatch: shell helpers missing or stale (want fe76955f7a14ddf7)" >&2; exit 125; }
rc=0; changed=0
tp_p='/opt/y'
tp_was "$tp_p"
if [ -e "$tp_p" ] || [ -L "$tp_p" ]; then
  tp_gate "$tp_p" || rc=1
  if [ "$rc" -eq 0 ]; then
    if [ -n "$tp_bd" ]; then tp_try "$tp_p" "$tp_bd/old" mv -- "$tp_p" "$tp_bd/old"; else rm -rf -- "$tp_p"; fi
    rc=$?
    if [ "$rc" -eq 0 ]; then changed=1; else tp_bk=; fi
  fi
fi
exit "$rc"
) </dev/null; } 3>&2 2>/dev/null
