---
source: crates/telepatch/tests/ops_snapshots.rs
expression: "format!(\"{}\\n{}\", wrapped(&h, d), wrapped(&h, a))"
---
(
__tp_esc() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; printf %s "$s"; }
__tp_emit() {
  if [ "$1" -ne 0 ]; then rc=$1; fi
  case "$rc" in ''|*[!0-9]*) rc=1;; esac
  case "$changed" in 1) __tp_c=true;; *) __tp_c=false;; esac
  case "$skipped" in 1) __tp_s=true;; *) __tp_s=false;; esac
  __tp_i=
  for __tp_x in "${installed[@]}"; do __tp_i="$__tp_i${__tp_i:+,}\"$(__tp_esc "$__tp_x")\""; done
  printf '\n__tp_testnonce 0 {"rc":%s,"changed":%s}\n' "$rc" "$__tp_c"
}
trap '__tp_emit $?' EXIT
rc=0; changed=0; skipped=0; installed=()
rc=0; changed=0
tp_p='/opt/x'
if [ -d "$tp_p" ]; then :
elif [ -e "$tp_p" ] || [ -L "$tp_p" ]; then
  echo "telepatch: $tp_p exists and is not a directory" >&2; rc=1
else
  (umask 022; mkdir -p -- "$tp_p")
  rc=$?
  if [ "$rc" -eq 0 ]; then changed=1; fi
fi
if [ "$rc" -eq 0 ] && [ "$(stat -L -c %a "$tp_p")" != '755' ]; then
  if chmod 755 "$tp_p"; then changed=1; else rc=$?; fi
fi
exit "$rc"
)

(
__tp_esc() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; printf %s "$s"; }
__tp_emit() {
  if [ "$1" -ne 0 ]; then rc=$1; fi
  case "$rc" in ''|*[!0-9]*) rc=1;; esac
  case "$changed" in 1) __tp_c=true;; *) __tp_c=false;; esac
  case "$skipped" in 1) __tp_s=true;; *) __tp_s=false;; esac
  __tp_i=
  for __tp_x in "${installed[@]}"; do __tp_i="$__tp_i${__tp_i:+,}\"$(__tp_esc "$__tp_x")\""; done
  printf '\n__tp_testnonce 1 {"rc":%s,"changed":%s}\n' "$rc" "$__tp_c"
}
trap '__tp_emit $?' EXIT
rc=0; changed=0; skipped=0; installed=()
rc=0; changed=0
tp_p='/opt/y'
if [ -e "$tp_p" ] || [ -L "$tp_p" ]; then
  rm -rf -- "$tp_p"
  rc=$?
  if [ "$rc" -eq 0 ]; then changed=1; fi
fi
exit "$rc"
)
