---
source: crates/telepatch/tests/svc.rs
expression: "render_host(\"h\", &h.os, &h.snapshot())"
---
host h (os: Debian/Debian 12)
blocking reads: 0

role (none)
  #0 svc as shell:root reads [] writes [svc:docker.service] post [svc:docker.service=Exists(true)]
      | tp_u='docker'
      | tp_run="${TP_SVC_RUNDIR:-/run/systemd/system}"
      | tp_skip=0
      | if ! command -v systemctl >/dev/null 2>&1; then
      |   skipped=1
      | else
      |   case "$(systemctl is-enabled -- "$tp_u" 2>/dev/null)" in
      |     enabled|enabled-runtime|static|alias) ;;
      |     *)
      |       systemctl enable -- "$tp_u"
      |       rc=$?
      |       if [ "$rc" -eq 0 ]; then changed=1; fi
      |       ;;
      |   esac
      |   if [ "$rc" -eq 0 ]; then
      |     if [ -d "$tp_run" ]; then
      |       if ! systemctl is-active --quiet -- "$tp_u"; then
      |         if [ "$(systemctl show -p NeedDaemonReload --value -- "$tp_u" 2>/dev/null)" = yes ]; then
      |           systemctl daemon-reload
      |           rc=$?
      |         fi
      |         if [ "$rc" -eq 0 ]; then
      |           systemctl start -- "$tp_u"
      |           rc=$?
      |           if [ "$rc" -eq 0 ]; then changed=1; fi
      |         fi
      |       fi
      |     else
      |       tp_skip=1
      |     fi
      |   fi
      |   if [ "$rc" -eq 0 ] && [ "$changed" -eq 0 ] && [ "$tp_skip" -eq 1 ]; then skipped=1; fi
      | fi
  #1 svc as shell:root reads [] writes [svc:docker.service] post [svc:docker.service=Exists(true)]
      | tp_u='docker.service'
      | tp_run="${TP_SVC_RUNDIR:-/run/systemd/system}"
      | tp_skip=0
      | if ! command -v systemctl >/dev/null 2>&1; then
      |   skipped=1
      | else
      |   case "$(systemctl is-enabled -- "$tp_u" 2>/dev/null)" in
      |     enabled|enabled-runtime|static|alias) ;;
      |     *)
      |       systemctl enable -- "$tp_u"
      |       rc=$?
      |       if [ "$rc" -eq 0 ]; then changed=1; fi
      |       ;;
      |   esac
      | fi
  #2 svc as shell:root reads [] writes [svc:ssh.socket] post [svc:ssh.socket=Exists(true)]
      | tp_u='ssh.socket'
      | tp_run="${TP_SVC_RUNDIR:-/run/systemd/system}"
      | tp_skip=0
      | if ! command -v systemctl >/dev/null 2>&1; then
      |   skipped=1
      | else
      |   if [ "$rc" -eq 0 ]; then
      |     if [ -d "$tp_run" ]; then
      |       if ! systemctl is-active --quiet -- "$tp_u"; then
      |         if [ "$(systemctl show -p NeedDaemonReload --value -- "$tp_u" 2>/dev/null)" = yes ]; then
      |           systemctl daemon-reload
      |           rc=$?
      |         fi
      |         if [ "$rc" -eq 0 ]; then
      |           systemctl start -- "$tp_u"
      |           rc=$?
      |           if [ "$rc" -eq 0 ]; then changed=1; fi
      |         fi
      |       fi
      |     else
      |       tp_skip=1
      |     fi
      |   fi
      |   if [ "$rc" -eq 0 ] && [ "$changed" -eq 0 ] && [ "$tp_skip" -eq 1 ]; then skipped=1; fi
      | fi
  #3 svc as login:root reads [] writes [svc:cron.service] post [svc:cron.service=Exists(true)]
      | tp_u='cron'
      | tp_run="${TP_SVC_RUNDIR:-/run/systemd/system}"
      | tp_skip=0
      | if ! command -v systemctl >/dev/null 2>&1; then
      |   skipped=1
      | else
      |   case "$(systemctl is-enabled -- "$tp_u" 2>/dev/null)" in
      |     enabled|enabled-runtime|static|alias) ;;
      |     *)
      |       systemctl enable -- "$tp_u"
      |       rc=$?
      |       if [ "$rc" -eq 0 ]; then changed=1; fi
      |       ;;
      |   esac
      | fi
