---
source: crates/telepatch/tests/ops_snapshots.rs
expression: "wrapped(&h, p.id())"
---
{ (
exec 2>&3 3>&-
__tp_esc() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; printf %s "$s"; }
__tp_emit() {
  if [ "$1" -ne 0 ]; then rc=$1; fi
  case "$rc" in ''|*[!0-9]*) rc=1;; esac
  case "$changed" in 1) __tp_c=true;; *) __tp_c=false;; esac
  case "$skipped" in 1) __tp_s=true;; *) __tp_s=false;; esac
  __tp_i=
  for __tp_x in "${installed[@]}"; do __tp_i="$__tp_i${__tp_i:+,}\"$(__tp_esc "$__tp_x")\""; done
  printf '\n__tp_testnonce 0 {"rc":%s,"changed":%s,"installed":[%s]}\n' "$rc" "$__tp_c" "$__tp_i"
}
trap '__tp_emit $?' EXIT
trap 'exit 143' TERM
rc=0; changed=0; skipped=0; installed=()
printf '\n__tpS_testnonce 0 %s %s\n' "$BASHPID" "$$"
rc=0; changed=0; installed=()
tp_want=('curl' 'jq')
tp_missing=()
export DEBIAN_FRONTEND=noninteractive
tp_up=()
apt-get -q update || rc=$?
for tp_n in "${tp_want[@]}"; do
  tp_st=$(dpkg-query -W -f='${db:Status-Status}:${Version}' "$tp_n" 2>/dev/null)
  case "$tp_st" in
    installed:*)
      tp_cand=$(LC_ALL=C apt-cache policy "$tp_n" 2>/dev/null | sed -n 's/^  Candidate: //p')
      if [ -n "$tp_cand" ] && [ "$tp_cand" != '(none)' ] && dpkg --compare-versions "$tp_cand" gt "${tp_st#installed:}"; then tp_up+=("$tp_n"); fi;;
    *) tp_missing+=("$tp_n");;
  esac
done
if [ "$rc" -eq 0 ] && [ "$(( ${#tp_missing[@]} + ${#tp_up[@]} ))" -gt 0 ]; then
  if [ "$rc" -eq 0 ] && [ "${#tp_missing[@]}" -gt 0 ]; then
    apt-get -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold install "${tp_missing[@]}"
    rc=$?
    if [ "$rc" -eq 0 ]; then changed=1; installed+=("${tp_missing[@]}"); fi
  fi
  if [ "$rc" -eq 0 ] && [ "${#tp_up[@]}" -gt 0 ]; then
    apt-get -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold install --only-upgrade "${tp_up[@]}"
    rc=$?
    if [ "$rc" -eq 0 ]; then changed=1; installed+=("${tp_up[@]}"); fi
  fi
fi
exit "$rc"
) </dev/null; } 3>&2 2>/dev/null
