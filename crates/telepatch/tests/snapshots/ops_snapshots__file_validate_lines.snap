---
source: crates/telepatch/tests/ops_snapshots.rs
expression: "wrapped(&h, id)"
---
{ (
exec 2>&3 3>&-
__tp_esc() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; printf %s "$s"; }
__tp_emit() {
  if [ "$1" -ne 0 ]; then rc=$1; fi
  case "$rc" in ''|*[!0-9]*) rc=1;; esac
  case "$changed" in 1) __tp_c=true;; *) __tp_c=false;; esac
  case "$skipped" in 1) __tp_s=true;; *) __tp_s=false;; esac
  __tp_i=
  for __tp_x in "${installed[@]}"; do __tp_i="$__tp_i${__tp_i:+,}\"$(__tp_esc "$__tp_x")\""; done
  printf '\n__tp_testnonce 0 {"rc":%s,"changed":%s}\n' "$rc" "$__tp_c"
}
trap '__tp_emit $?' EXIT
trap 'exit 143' TERM
rc=0; changed=0; skipped=0; installed=()
printf '\n__tpS_testnonce 0 %s %s\n' "$BASHPID" "$$"
rc=0; changed=0
tp_p='/etc/ssh/sshd_config'
if [ -d "$tp_p" ]; then echo "telepatch: $tp_p is a directory" >&2; rc=1; fi
if [ "$rc" -eq 0 ]; then
  tp_c=$(mktemp "$tp_p.tpXXXXXX") || rc=$?
fi
if [ "$rc" -eq 0 ]; then
  if [ -f "$tp_p" ]; then cat "$tp_p" > "$tp_c" || rc=$?; fi
tp_append() {
  if [ -s "$1" ] && [ -n "$(tail -c1 "$1")" ]; then printf '\n' >> "$1"; fi
  printf '%s\n' "$2" >> "$1"
}
if [ "$rc" -eq 0 ]; then
  if [ ! -e "$tp_c" ]; then (umask 022; : > "$tp_c") && changed=1 || rc=$?; fi
  tp_l='PermitRootLogin no'
  tp_n=$(grep -nE -- '^PermitRootLogin' "$tp_c" | tail -n 1 | cut -d: -f1)
  if [ "$rc" -ne 0 ]; then :
  elif [ -z "$tp_n" ]; then
    if tp_append "$tp_c" "$tp_l"; then changed=1; else rc=$?; fi
  elif [ "$(sed -n "${tp_n}p" "$tp_c")" != "$tp_l" ]; then
    tp_t=$(mktemp) && TP_L="$tp_l" awk -v n="$tp_n" 'NR==n { print ENVIRON["TP_L"]; next } { print }' "$tp_c" > "$tp_t" && cat "$tp_t" > "$tp_c"
    rc=$?
    rm -f "$tp_t"
    if [ "$rc" -eq 0 ]; then changed=1; fi
  fi
fi
if [ "$rc" -eq 0 ]; then
  if [ ! -e "$tp_c" ]; then (umask 022; : > "$tp_c") && changed=1 || rc=$?; fi
  tp_l='UseDNS no'
  if [ "$rc" -eq 0 ] && ! grep -qxF -- "$tp_l" "$tp_c"; then
    if tp_append "$tp_c" "$tp_l"; then changed=1; else rc=$?; fi
  fi
fi
  changed=0
  if [ "$rc" -eq 0 ] && { [ ! -e "$tp_p" ] || [ "$(sha256sum < "$tp_c" | cut -d' ' -f1)" != "$(sha256sum < "$tp_p" | cut -d' ' -f1)" ]; }; then
    if [ -e "$tp_p" ]; then chmod --reference="$tp_p" "$tp_c" || rc=$?; else chmod 644 "$tp_c" || rc=$?; fi
    if [ "$rc" -eq 0 ] && [ -e "$tp_p" ]; then chown --reference="$tp_p" "$tp_c" 2>/dev/null; fi
    if [ "$rc" -eq 0 ]; then
      tp_vc='sshd -t -f "$tp_c"'
      ( eval "$tp_vc" ) || rc=$?
    fi
    if [ "$rc" -eq 0 ]; then
      mv -f "$tp_c" "$tp_p"; rc=$?
      if [ "$rc" -eq 0 ]; then changed=1; fi
    fi
  fi
  rm -f "$tp_c"
fi
exit "$rc"
) </dev/null; } 3>&2 2>/dev/null
