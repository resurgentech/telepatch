---
source: crates/telepatch/tests/ops_snapshots.rs
expression: "wrapped(&h, p.id())"
---
(
__tp_esc() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; printf %s "$s"; }
__tp_emit() {
  if [ "$1" -ne 0 ]; then rc=$1; fi
  case "$rc" in ''|*[!0-9]*) rc=1;; esac
  case "$changed" in 1) __tp_c=true;; *) __tp_c=false;; esac
  case "$skipped" in 1) __tp_s=true;; *) __tp_s=false;; esac
  __tp_i=
  for __tp_x in "${installed[@]}"; do __tp_i="$__tp_i${__tp_i:+,}\"$(__tp_esc "$__tp_x")\""; done
  printf '\n__tp_testnonce 0 {"rc":%s,"changed":%s,"installed":[%s]}\n' "$rc" "$__tp_c" "$__tp_i"
}
trap '__tp_emit $?' EXIT
rc=0; changed=0; skipped=0; installed=()
rc=0; changed=0; installed=()
tp_want=('jq' 'git')
tp_missing=()
tp_up=()
for tp_n in "${tp_want[@]}"; do
  tp_have=$(pacman -Q "$tp_n" 2>/dev/null | cut -d' ' -f2)
  if [ -z "$tp_have" ]; then tp_missing+=("$tp_n"); continue; fi
  tp_repo=$(pacman -Si "$tp_n" 2>/dev/null | sed -n 's/^Version *: //p' | head -n1)
  if [ -n "$tp_repo" ] && [ "$(vercmp "$tp_repo" "$tp_have")" -gt 0 ]; then tp_up+=("$tp_n"); fi
done
tp_todo=("${tp_missing[@]}" "${tp_up[@]}")
if [ "${#tp_todo[@]}" -gt 0 ]; then
  pacman -S --needed --noconfirm "${tp_todo[@]}"
  rc=$?
  if [ "$rc" -eq 0 ]; then changed=1; installed=("${tp_todo[@]}"); fi
fi
exit "$rc"
) </dev/null
