---
source: crates/telepatch/tests/ops_snapshots.rs
expression: "wrapped(&h, id)"
---
(
__tp_esc() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; printf %s "$s"; }
__tp_emit() {
  if [ "$1" -ne 0 ]; then rc=$1; fi
  case "$rc" in ''|*[!0-9]*) rc=1;; esac
  case "$changed" in 1) __tp_c=true;; *) __tp_c=false;; esac
  case "$skipped" in 1) __tp_s=true;; *) __tp_s=false;; esac
  __tp_i=
  for __tp_x in "${installed[@]}"; do __tp_i="$__tp_i${__tp_i:+,}\"$(__tp_esc "$__tp_x")\""; done
  printf '\n__tp_testnonce 0 {"rc":%s,"changed":%s}\n' "$rc" "$__tp_c"
}
trap '__tp_emit $?' EXIT
rc=0; changed=0; skipped=0; installed=()
rc=0; changed=0
tp_p='/etc/motd'
if [ -d "$tp_p" ]; then echo "telepatch: $tp_p is a directory" >&2; rc=1; fi
tp_b='aGkK'
if [ "$rc" -eq 0 ] && ! { [ -f "$tp_p" ] && printf %s "$tp_b" | base64 -d | cmp -s - "$tp_p"; }; then
  tp_t=$(mktemp "$tp_p.tpXXXXXX") || rc=$?
  if [ "$rc" -eq 0 ]; then
    if printf %s "$tp_b" | base64 -d > "$tp_t"; then
      if [ -e "$tp_p" ]; then
        chmod --reference="$tp_p" "$tp_t"; chown --reference="$tp_p" "$tp_t" 2>/dev/null
      else
        chmod 644 "$tp_t"
      fi
      mv -f "$tp_t" "$tp_p"; rc=$?
    else
      rc=$?
    fi
    if [ "$rc" -eq 0 ]; then changed=1; else rm -f "$tp_t"; fi
  fi
fi
if [ "$rc" -eq 0 ] && [ "$(stat -L -c %a "$tp_p")" != '644' ]; then
  if chmod 644 "$tp_p"; then changed=1; else rc=$?; fi
fi
if [ "$rc" -eq 0 ] && [ "$(stat -L -c '%U:%G' "$tp_p")" != 'root:root' ]; then
  if chown 'root:root' "$tp_p"; then changed=1; else rc=$?; fi
fi
exit "$rc"
) </dev/null
