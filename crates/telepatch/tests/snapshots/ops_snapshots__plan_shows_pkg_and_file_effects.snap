---
source: crates/telepatch/tests/ops_snapshots.rs
expression: "render_host(\"h\", &h.os, &h.snapshot())"
---
host h (os: Debian/Debian 12)
blocking reads: 0

role (none)
  #0 pkg as shell:root reads [] writes [pkg:curl] post [pkg:curl=Installed]
      | rc=0; changed=0; installed=()
      | tp_want=('curl')
      | tp_missing=()
      | export DEBIAN_FRONTEND=noninteractive
      | tp_apt_present() {
      |   [ "$(dpkg-query -W -f='${db:Status-Status}' "$1" 2>/dev/null)" = installed ] && return 0
      |   dpkg-query -W -f='${db:Status-Status} ${Provides}\n' 2>/dev/null | awk -v n="$1" '$1 != "installed" { next } { line=$0; sub(/^installed[[:space:]]+/, "", line); k=split(line, parts, /,/); for (i=1; i<=k; i++) { p=parts[i]; gsub(/^[[:space:]]+|[[:space:]]+$/, "", p); sub(/[[:space:]].*/, "", p); if (p == n) found=1 } } END { exit (found ? 0 : 1) }'
      | }
      | for tp_n in "${tp_want[@]}"; do
      |   tp_apt_present "$tp_n" || tp_missing+=("$tp_n")
      | done
      | if [ "$rc" -eq 0 ] && [ "${#tp_missing[@]}" -gt 0 ]; then
      |   if ! find /var/lib/apt/lists -maxdepth 1 -type f ! -name lock 2>/dev/null | grep -q .; then apt-get -q update || rc=$?; fi
      |   if [ "$rc" -eq 0 ]; then
      |     apt-get -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold install "${tp_missing[@]}"
      |     rc=$?
      |     if [ "$rc" -eq 0 ]; then changed=1; installed=("${tp_missing[@]}"); fi
      |   fi
      | fi
  #1 pkg as shell:root reads [] writes [pkg:pip:requests] post [pkg:pip:requests=Installed]
      | rc=0; changed=0; installed=()
      | tp_want=('requests')
      | tp_missing=()
      | if python3 -m pip --version >/dev/null 2>&1; then tp_pip=(python3 -m pip)
      | elif command -v pip3 >/dev/null 2>&1; then tp_pip=(pip3)
      | else echo 'telepatch: pip not found' >&2; rc=127; fi
      | if [ "$rc" -eq 0 ]; then
      |   for tp_n in "${tp_want[@]}"; do
      |     "${tp_pip[@]}" show "$tp_n" >/dev/null 2>&1 || tp_missing+=("$tp_n")
      |   done
      |   if [ "${#tp_missing[@]}" -gt 0 ]; then
      |     "${tp_pip[@]}" install "${tp_missing[@]}"
      |     rc=$?
      |     if [ "$rc" -eq 0 ]; then changed=1; installed=("${tp_missing[@]}"); fi
      |   fi
      | fi
  #2 pkg as shell:root reads [] writes [*]
      | rc=0; changed=0; installed=()
      | tp_want=('python3')
      | tp_missing=()
      | export DEBIAN_FRONTEND=noninteractive
      | if [ "$rc" -eq 0 ]; then
      |   :
      |   if ! find /var/lib/apt/lists -maxdepth 1 -type f ! -name lock 2>/dev/null | grep -q .; then apt-get -q update || rc=$?; fi
      | fi
      | if [ "$rc" -eq 0 ]; then
      |   tp_out=$(mktemp)
      |   LC_ALL=C apt-get -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold build-dep "${tp_want[@]}" 2>&1 | tee "$tp_out"
      |   rc=${PIPESTATUS[0]}
      |   if [ "$rc" -eq 0 ] && grep -Eq '[1-9][0-9]* newly installed' "$tp_out"; then changed=1; fi
      |   rm -f "$tp_out"
      | fi
  #3 file as shell:root reads [] writes [file:/etc/a] post [file:/etc/a=Exists(true)]
      | rc=0; changed=0
      | tp_p='/etc/a'
      | tp_fsroot() {
      |   local d=$1 r s= q v a; case $d in /*) ;; *) d=$PWD/$d;; esac
      |   IFS=: read -ra a <<<"${TP_FS_ROOTS-}"
      |   for r in "${a[@]}"; do r=${r%/}; [ -n "$r" ] || continue; case "$d/" in "$r"/*) [ ${#r} -gt ${#s} ] && s=$r;; esac; done
      |   if [ -n "$s" ]; then printf %s "$s"; return; fi
      |   while [ ! -e "$d" ] && [ ! -L "$d" ]; do d=$(dirname -- "$d"); done
      |   v=$(stat -c %d -- "$d")
      |   while q=$(dirname -- "$d"); [ "$q" != "$d" ] && [ "$(stat -c %d -- "$q")" = "$v" ]; do d=$q; done
      |   printf %s "$d"
      | }
      | tp_was() {
      |   if [ -L "$1" ]; then tp_wt=symlink; elif [ -d "$1" ]; then tp_wt=dir; elif [ -e "$1" ]; then tp_wt=file; else return 0; fi
      |   tp_ex=1; tp_wm=$(stat -c %a -- "$1"); tp_wo=$(stat -c %U:%G -- "$1")
      | }
      | tp_try() { local p=$1 w=$2 e; shift 2; e=$("$@" 2>&1) || { echo "telepatch: file $p: cannot save undo data: $w: ${e##*: }" >&2; return 1; }; }
      | tp_mkd() { [ -d "$2" ] || tp_try "$tp_up" "$2" mkdir -m "$1" -- "$2"; }
      | tp_idx() { grep -qxF -- "$1" "$2" 2>/dev/null || (umask 077; printf '%s\n' "$1" >> "$2"); }
      | tp_undo() {
      |   tp_bd=; tp_bk=; [ -n "${__tp_run-}" ] || return 0
      |   local sd=${TP_FETCH_STAGE:-/var/tmp/telepatch} u r s t i n=
      |   tp_up=$1; u=$(id -un); r=$(tp_fsroot "$1"); s=$sd/$__tp_run; t=$r/.telepatch/tmp/$__tp_run
      |   [ -d "$r" ] || { echo "telepatch: file $1: is a mount point" >&2; return 1; }
      |   if [ "$r" != "$(tp_fsroot "$sd")" ] && [ ! -d "$t/undo/$u" ]; then
      |     case ":${TP_FS_ROOTS-}:" in *":$r:"*) ;; *) [ "$(id -u)" = 0 ] || { echo "telepatch: file $1: cannot save undo data: $t/undo/$u: not prepared" >&2; return 1; };; esac
      |   fi
      |   tp_try "$1" "$s/undo" mkdir -p -m 711 -- "$s/undo" && tp_mkd 700 "$s/undo/$u" || return 1
      |   tp_bk=$s/undo/$u/$tp_id
      |   if [ "$r" = "$(tp_fsroot "$sd")" ]; then tp_bd=$tp_bk
      |   else
      |     if [ ! -d "$t/undo/$u" ]; then
      |       [ -d "$t" ] || n=1
      |       for i in "$r/.telepatch" "$r/.telepatch/tmp" "$t" "$t/undo"; do
      |         tp_mkd 711 "$i" || return 1
      |         if [ "$i" = "$t" ] && [ -n "$n" ]; then tp_try "$1" "$s/fsroots" tp_idx "$r" "$s/fsroots" || return 1; fi
      |       done
      |       tp_mkd 700 "$t/undo/$u" || return 1
      |     fi
      |     tp_bd=$t/undo/$u/$tp_id
      |   fi
      |   tp_try "$1" "$tp_bd" mkdir -p -m 700 -- "$tp_bd" || return 1
      |   [ "$tp_bd" = "$tp_bk" ] || tp_try "$1" "$tp_bk" ln -sfn -- "$tp_bd" "$tp_bk"
      | }
      | tp_save() {
      |   [ "${tp_ex-}" = 1 ] && [ -z "${tp_sv-}" ] || return 0; tp_sv=1
      |   tp_undo "$1" && { [ -z "$tp_bd" ] || tp_try "$1" "$tp_bd/old" cp -a${2:+L} -- "$1" "$tp_bd/old"; } || { tp_bk=; return 1; }
      | }
      | tp_mnt() {
      |   local p=${1%/} r a; IFS=: read -ra a <<<"${TP_FS_ROOTS-}"
      |   for r in "${a[@]}"; do [ "${r%/}" = "$p" ] && return 0; done
      |   [ ! -L "$p" ] && [ -e "$p" ] && [ "$(stat -c %d -- "$p")" != "$(stat -c %d -- "$(dirname -- "$p")")" ]
      | }
      | tp_nest() {
      |   local p=${1%/} r a; IFS=: read -ra a <<<"${TP_FS_ROOTS-}"
      |   for r in "${a[@]}"; do r=${r%/}; case "$r/" in "$p"/?*) printf %s "$r"; return 0;; esac; done
      |   [ -d "$p" ] && [ ! -L "$p" ] || return 1
      |   r=$(find "$p" -mindepth 1 -type d -printf '%D %p\n' 2>/dev/null | awk -v d="$(stat -c %d -- "$p")" '$1 != d { sub(/^[^ ]* /, ""); print; exit }')
      |   [ -n "$r" ] && printf %s "$r"
      | }
      | tp_gate() {
      |   local m
      |   if tp_mnt "$1"; then echo "telepatch: file $1: is a mount point" >&2; return 1; fi
      |   if m=$(tp_nest "$1"); then echo "telepatch: file $1: a filesystem is mounted under it ($m)" >&2; return 1; fi
      |   [ -n "${2-}" ] && return 0
      |   tp_undo "$1" || { tp_bk=; return 1; }
      | }
      | tp_mk() {
      |   local x=$1; tp_cx=
      |   while [ ! -e "$x" ] && [ ! -L "$x" ]; do tp_cx=$x; x=$(dirname -- "$x"); done
      |   (umask 022; mkdir -p -- "$1")
      | }
      | tp_open() { [ -n "${tp_og-}" ] || { tp_undo "$tp_p" && tp_og=1 || { tp_bk=; return 1; }; }; }
      | tp_note() { [ -z "$tp_bd" ] || tp_try "$tp_p" "$tp_bd/created" tp_idx "$1 $2" "$tp_bd/created"; }
      | tp_cp() {
      |   tp_open || return 1; [ -z "$tp_bd" ] && return 0
      |   tp_try "$tp_p" "$tp_bd/old/$2" mkdir -p -- "$(dirname -- "$tp_bd/old/$2")" && tp_try "$tp_p" "$tp_bd/old/$2" cp -a -- "$1" "$tp_bd/old/$2"
      | }
      | tp_was "$tp_p"
      | if [ -d "$tp_p" ]; then echo "telepatch: $tp_p is a directory" >&2; rc=1; fi
      | if [ "$rc" -eq 0 ] && [ ! -e "$tp_p" ]; then
      |   (umask 022; : > "$tp_p")
      |   rc=$?
      |   if [ "$rc" -eq 0 ]; then changed=1; fi
      | fi
      | tp_append() {
      |   if [ -s "$1" ] && [ -n "$(tail -c1 "$1")" ]; then printf '\n' >> "$1"; fi
      |   printf '%s\n' "$2" >> "$1"
      | }
      | if [ "$rc" -eq 0 ]; then
      |   if [ ! -e "$tp_p" ]; then (umask 022; : > "$tp_p") && changed=1 || rc=$?; fi
      |   tp_l='x'
      |   if [ "$rc" -eq 0 ] && ! grep -qxF -- "$tp_l" "$tp_p"; then
      |     if tp_save "$tp_p" L && tp_append "$tp_p" "$tp_l"; then changed=1; else rc=$?; fi
      |   fi
      | fi
  #4 file as shell:root reads [] writes [file:/etc/b] post [file:/etc/b=Exists(false)]
      | rc=0; changed=0
      | tp_p='/etc/b'
      | tp_fsroot() {
      |   local d=$1 r s= q v a; case $d in /*) ;; *) d=$PWD/$d;; esac
      |   IFS=: read -ra a <<<"${TP_FS_ROOTS-}"
      |   for r in "${a[@]}"; do r=${r%/}; [ -n "$r" ] || continue; case "$d/" in "$r"/*) [ ${#r} -gt ${#s} ] && s=$r;; esac; done
      |   if [ -n "$s" ]; then printf %s "$s"; return; fi
      |   while [ ! -e "$d" ] && [ ! -L "$d" ]; do d=$(dirname -- "$d"); done
      |   v=$(stat -c %d -- "$d")
      |   while q=$(dirname -- "$d"); [ "$q" != "$d" ] && [ "$(stat -c %d -- "$q")" = "$v" ]; do d=$q; done
      |   printf %s "$d"
      | }
      | tp_was() {
      |   if [ -L "$1" ]; then tp_wt=symlink; elif [ -d "$1" ]; then tp_wt=dir; elif [ -e "$1" ]; then tp_wt=file; else return 0; fi
      |   tp_ex=1; tp_wm=$(stat -c %a -- "$1"); tp_wo=$(stat -c %U:%G -- "$1")
      | }
      | tp_try() { local p=$1 w=$2 e; shift 2; e=$("$@" 2>&1) || { echo "telepatch: file $p: cannot save undo data: $w: ${e##*: }" >&2; return 1; }; }
      | tp_mkd() { [ -d "$2" ] || tp_try "$tp_up" "$2" mkdir -m "$1" -- "$2"; }
      | tp_idx() { grep -qxF -- "$1" "$2" 2>/dev/null || (umask 077; printf '%s\n' "$1" >> "$2"); }
      | tp_undo() {
      |   tp_bd=; tp_bk=; [ -n "${__tp_run-}" ] || return 0
      |   local sd=${TP_FETCH_STAGE:-/var/tmp/telepatch} u r s t i n=
      |   tp_up=$1; u=$(id -un); r=$(tp_fsroot "$1"); s=$sd/$__tp_run; t=$r/.telepatch/tmp/$__tp_run
      |   [ -d "$r" ] || { echo "telepatch: file $1: is a mount point" >&2; return 1; }
      |   if [ "$r" != "$(tp_fsroot "$sd")" ] && [ ! -d "$t/undo/$u" ]; then
      |     case ":${TP_FS_ROOTS-}:" in *":$r:"*) ;; *) [ "$(id -u)" = 0 ] || { echo "telepatch: file $1: cannot save undo data: $t/undo/$u: not prepared" >&2; return 1; };; esac
      |   fi
      |   tp_try "$1" "$s/undo" mkdir -p -m 711 -- "$s/undo" && tp_mkd 700 "$s/undo/$u" || return 1
      |   tp_bk=$s/undo/$u/$tp_id
      |   if [ "$r" = "$(tp_fsroot "$sd")" ]; then tp_bd=$tp_bk
      |   else
      |     if [ ! -d "$t/undo/$u" ]; then
      |       [ -d "$t" ] || n=1
      |       for i in "$r/.telepatch" "$r/.telepatch/tmp" "$t" "$t/undo"; do
      |         tp_mkd 711 "$i" || return 1
      |         if [ "$i" = "$t" ] && [ -n "$n" ]; then tp_try "$1" "$s/fsroots" tp_idx "$r" "$s/fsroots" || return 1; fi
      |       done
      |       tp_mkd 700 "$t/undo/$u" || return 1
      |     fi
      |     tp_bd=$t/undo/$u/$tp_id
      |   fi
      |   tp_try "$1" "$tp_bd" mkdir -p -m 700 -- "$tp_bd" || return 1
      |   [ "$tp_bd" = "$tp_bk" ] || tp_try "$1" "$tp_bk" ln -sfn -- "$tp_bd" "$tp_bk"
      | }
      | tp_save() {
      |   [ "${tp_ex-}" = 1 ] && [ -z "${tp_sv-}" ] || return 0; tp_sv=1
      |   tp_undo "$1" && { [ -z "$tp_bd" ] || tp_try "$1" "$tp_bd/old" cp -a${2:+L} -- "$1" "$tp_bd/old"; } || { tp_bk=; return 1; }
      | }
      | tp_mnt() {
      |   local p=${1%/} r a; IFS=: read -ra a <<<"${TP_FS_ROOTS-}"
      |   for r in "${a[@]}"; do [ "${r%/}" = "$p" ] && return 0; done
      |   [ ! -L "$p" ] && [ -e "$p" ] && [ "$(stat -c %d -- "$p")" != "$(stat -c %d -- "$(dirname -- "$p")")" ]
      | }
      | tp_nest() {
      |   local p=${1%/} r a; IFS=: read -ra a <<<"${TP_FS_ROOTS-}"
      |   for r in "${a[@]}"; do r=${r%/}; case "$r/" in "$p"/?*) printf %s "$r"; return 0;; esac; done
      |   [ -d "$p" ] && [ ! -L "$p" ] || return 1
      |   r=$(find "$p" -mindepth 1 -type d -printf '%D %p\n' 2>/dev/null | awk -v d="$(stat -c %d -- "$p")" '$1 != d { sub(/^[^ ]* /, ""); print; exit }')
      |   [ -n "$r" ] && printf %s "$r"
      | }
      | tp_gate() {
      |   local m
      |   if tp_mnt "$1"; then echo "telepatch: file $1: is a mount point" >&2; return 1; fi
      |   if m=$(tp_nest "$1"); then echo "telepatch: file $1: a filesystem is mounted under it ($m)" >&2; return 1; fi
      |   [ -n "${2-}" ] && return 0
      |   tp_undo "$1" || { tp_bk=; return 1; }
      | }
      | tp_mk() {
      |   local x=$1; tp_cx=
      |   while [ ! -e "$x" ] && [ ! -L "$x" ]; do tp_cx=$x; x=$(dirname -- "$x"); done
      |   (umask 022; mkdir -p -- "$1")
      | }
      | tp_open() { [ -n "${tp_og-}" ] || { tp_undo "$tp_p" && tp_og=1 || { tp_bk=; return 1; }; }; }
      | tp_note() { [ -z "$tp_bd" ] || tp_try "$tp_p" "$tp_bd/created" tp_idx "$1 $2" "$tp_bd/created"; }
      | tp_cp() {
      |   tp_open || return 1; [ -z "$tp_bd" ] && return 0
      |   tp_try "$tp_p" "$tp_bd/old/$2" mkdir -p -- "$(dirname -- "$tp_bd/old/$2")" && tp_try "$tp_p" "$tp_bd/old/$2" cp -a -- "$1" "$tp_bd/old/$2"
      | }
      | tp_was "$tp_p"
      | if [ -e "$tp_p" ] || [ -L "$tp_p" ]; then
      |   tp_gate "$tp_p" || rc=1
      |   if [ "$rc" -eq 0 ]; then
      |     if [ -n "$tp_bd" ]; then tp_try "$tp_p" "$tp_bd/old" mv -- "$tp_p" "$tp_bd/old"; else rm -rf -- "$tp_p"; fi
      |     rc=$?
      |     if [ "$rc" -eq 0 ]; then changed=1; else tp_bk=; fi
      |   fi
      | fi
