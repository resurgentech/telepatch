---
source: crates/telepatch/tests/ops_snapshots.rs
expression: "wrapped(&h, id)"
---
(
__tp_esc() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; printf %s "$s"; }
__tp_emit() {
  if [ "$1" -ne 0 ]; then rc=$1; fi
  case "$rc" in ''|*[!0-9]*) rc=1;; esac
  case "$changed" in 1) __tp_c=true;; *) __tp_c=false;; esac
  case "$skipped" in 1) __tp_s=true;; *) __tp_s=false;; esac
  __tp_i=
  for __tp_x in "${installed[@]}"; do __tp_i="$__tp_i${__tp_i:+,}\"$(__tp_esc "$__tp_x")\""; done
  printf '\n__tp_testnonce 0 {"rc":%s,"changed":%s}\n' "$rc" "$__tp_c"
}
trap '__tp_emit $?' EXIT
rc=0; changed=0; skipped=0; installed=()
rc=0; changed=0
tp_p=~/'.zshrc'
if [ -d "$tp_p" ]; then echo "telepatch: $tp_p is a directory" >&2; rc=1; fi
if [ "$rc" -eq 0 ] && [ ! -e "$tp_p" ]; then
  (umask 022; : > "$tp_p")
  rc=$?
  if [ "$rc" -eq 0 ]; then changed=1; fi
fi
tp_append() {
  if [ -s "$1" ] && [ -n "$(tail -c1 "$1")" ]; then printf '\n' >> "$1"; fi
  printf '%s\n' "$2" >> "$1"
}
if [ "$rc" -eq 0 ]; then
  if [ ! -e "$tp_p" ]; then (umask 022; : > "$tp_p") && changed=1 || rc=$?; fi
  tp_l='export A=1'
  if [ "$rc" -eq 0 ] && ! grep -qxF -- "$tp_l" "$tp_p"; then
    if tp_append "$tp_p" "$tp_l"; then changed=1; else rc=$?; fi
  fi
fi
if [ "$rc" -eq 0 ]; then
  if [ ! -e "$tp_p" ]; then (umask 022; : > "$tp_p") && changed=1 || rc=$?; fi
  tp_l='ZSH_THEME="x"'
  tp_n=$(grep -nE -- '^ZSH_THEME=' "$tp_p" | tail -n 1 | cut -d: -f1)
  if [ "$rc" -ne 0 ]; then :
  elif [ -z "$tp_n" ]; then
    if tp_append "$tp_p" "$tp_l"; then changed=1; else rc=$?; fi
  elif [ "$(sed -n "${tp_n}p" "$tp_p")" != "$tp_l" ]; then
    tp_t=$(mktemp) && TP_L="$tp_l" awk -v n="$tp_n" 'NR==n { print ENVIRON["TP_L"]; next } { print }' "$tp_p" > "$tp_t" && cat "$tp_t" > "$tp_p"
    rc=$?
    rm -f "$tp_t"
    if [ "$rc" -eq 0 ]; then changed=1; fi
  fi
fi
exit "$rc"
) </dev/null
