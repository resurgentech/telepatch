---
source: crates/telepatch/tests/adversarial/cargo_does_not_cross_distro_pkg.rs
expression: out
---
host web1 (os: Debian/Ubuntu 24.04)
blocking reads: 0

window 1 (final)
role a
  #1 pkg[cargo] as shell:root reads [] writes [pkg:cargo:root:cargo-deb, home:root] post [pkg:cargo:root:cargo-deb=Installed]
      | rc=0; changed=0; installed=()
      | tp_want=('cargo-deb')
      | declare -A tp_before=() tp_after=() tp_wantv=()
      | tp_todo=()
      | tp_list() { cargo install --list 2>/dev/null | sed -n 's/^\([^ ][^ ]*\) v\([^ :][^ :]*\)[^:]*:$/\1 \2/p'; }
      | if ! command -v cargo >/dev/null 2>&1; then echo 'telepatch: cargo not found' >&2; rc=127; fi
      | if [ "$rc" -eq 0 ]; then
      |   while read -r tp_n tp_v; do tp_before[$tp_n]=$tp_v; done < <(tp_list)
      |   for tp_n in "${tp_want[@]}"; do
      |     [ -n "${tp_before[$tp_n]+x}" ] || tp_todo+=("$tp_n")
      |   done
      | fi
      | if [ "$rc" -eq 0 ] && [ "${#tp_todo[@]}" -gt 0 ]; then
      |   cargo install "${tp_todo[@]}"
      |   rc=$?
      |   while read -r tp_n tp_v; do tp_after[$tp_n]=$tp_v; done < <(tp_list)
      |   for tp_n in "${tp_want[@]}"; do
      |     if [ "${tp_after[$tp_n]-}" != "${tp_before[$tp_n]-}" ]; then changed=1; installed+=("$tp_n"); fi
      |   done
      |   if [ "$rc" -eq 0 ]; then
      |     for tp_n in "${tp_todo[@]}"; do
      |       tp_got=${tp_after[$tp_n]-}; tp_wv=${tp_wantv[$tp_n]-}
      |       if [ -z "$tp_got" ] || { [ -n "$tp_wv" ] && [ "$tp_got" != "$tp_wv" ]; }; then
      |         echo "telepatch: cargo $tp_n: installed ${tp_got:-absent}, wanted ${tp_wv:-present}" >&2; rc=1
      |       fi
      |     done
      |   fi
      | fi
role b
  #4 pkg as shell:root reads [] writes [pkg:libssl-dev] post [pkg:libssl-dev=Installed]
      | rc=0; changed=0; installed=()
      | tp_want=('libssl-dev')
      | tp_missing=()
      | export DEBIAN_FRONTEND=noninteractive
      | tp_apt_present() {
      |   [ "$(dpkg-query -W -f='${db:Status-Status}' "$1" 2>/dev/null)" = installed ] && return 0
      |   dpkg-query -W -f='${db:Status-Status} ${Provides}\n' 2>/dev/null | awk -v n="$1" '$1 != "installed" { next } { line=$0; sub(/^installed[[:space:]]+/, "", line); k=split(line, parts, /,/); for (i=1; i<=k; i++) { p=parts[i]; gsub(/^[[:space:]]+|[[:space:]]+$/, "", p); sub(/[[:space:]].*/, "", p); if (p == n) found=1 } } END { exit (found ? 0 : 1) }'
      | }
      | for tp_n in "${tp_want[@]}"; do
      |   tp_apt_present "$tp_n" || tp_missing+=("$tp_n")
      | done
      | if [ "$rc" -eq 0 ] && [ "${#tp_missing[@]}" -gt 0 ]; then
      |   if ! find /var/lib/apt/lists -maxdepth 1 -type f ! -name lock 2>/dev/null | grep -q .; then apt-get -q update || rc=$?; fi
      |   if [ "$rc" -eq 0 ]; then
      |     apt-get -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold install "${tp_missing[@]}"
      |     rc=$?
      |     if [ "$rc" -eq 0 ]; then changed=1; installed=("${tp_missing[@]}"); fi
      |   fi
      | fi
  #5 pkg[cargo] as shell:root reads [] writes [pkg:cargo:root:cargo-generate-rpm, home:root] post [pkg:cargo:root:cargo-generate-rpm=Installed]
      | rc=0; changed=0; installed=()
      | tp_want=('cargo-generate-rpm')
      | declare -A tp_before=() tp_after=() tp_wantv=()
      | tp_todo=()
      | tp_list() { cargo install --list 2>/dev/null | sed -n 's/^\([^ ][^ ]*\) v\([^ :][^ :]*\)[^:]*:$/\1 \2/p'; }
      | if ! command -v cargo >/dev/null 2>&1; then echo 'telepatch: cargo not found' >&2; rc=127; fi
      | if [ "$rc" -eq 0 ]; then
      |   while read -r tp_n tp_v; do tp_before[$tp_n]=$tp_v; done < <(tp_list)
      |   for tp_n in "${tp_want[@]}"; do
      |     [ -n "${tp_before[$tp_n]+x}" ] || tp_todo+=("$tp_n")
      |   done
      | fi
      | if [ "$rc" -eq 0 ] && [ "${#tp_todo[@]}" -gt 0 ]; then
      |   cargo install "${tp_todo[@]}"
      |   rc=$?
      |   while read -r tp_n tp_v; do tp_after[$tp_n]=$tp_v; done < <(tp_list)
      |   for tp_n in "${tp_want[@]}"; do
      |     if [ "${tp_after[$tp_n]-}" != "${tp_before[$tp_n]-}" ]; then changed=1; installed+=("$tp_n"); fi
      |   done
      |   if [ "$rc" -eq 0 ]; then
      |     for tp_n in "${tp_todo[@]}"; do
      |       tp_got=${tp_after[$tp_n]-}; tp_wv=${tp_wantv[$tp_n]-}
      |       if [ -z "$tp_got" ] || { [ -n "$tp_wv" ] && [ "$tp_got" != "$tp_wv" ]; }; then
      |         echo "telepatch: cargo $tp_n: installed ${tp_got:-absent}, wanted ${tp_wv:-present}" >&2; rc=1
      |       fi
      |     done
      |   fi
      | fi
