---
source: crates/telepatch/tests/adversarial/merge_roles.rs
expression: "plan(&Playbook { name: \"t\", run }, &super::common::ubuntu())"
---
host web1 (os: Debian/Ubuntu 24.04)
blocking reads: 0

window 1 (final)
role base
  #1 pkg as shell:root reads [] writes [pkg:curl, pkg:git, pkg:nginx, pkg:prometheus-node-exporter] post [pkg:curl=Installed, pkg:git=Installed, pkg:nginx=Installed, pkg:prometheus-node-exporter=Installed]
      | rc=0; changed=0; installed=()
      | tp_want=('curl' 'git' 'nginx' 'prometheus-node-exporter')
      | tp_missing=()
      | export DEBIAN_FRONTEND=noninteractive
      | for tp_n in "${tp_want[@]}"; do
      |   [ "$(dpkg-query -W -f='${db:Status-Status}' "$tp_n" 2>/dev/null)" = installed ] || tp_missing+=("$tp_n")
      | done
      | if [ "$rc" -eq 0 ] && [ "${#tp_missing[@]}" -gt 0 ]; then
      |   if ! find /var/lib/apt/lists -maxdepth 1 -type f ! -name lock 2>/dev/null | grep -q .; then apt-get -q update || rc=$?; fi
      |   if [ "$rc" -eq 0 ]; then
      |     apt-get -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold install "${tp_missing[@]}"
      |     rc=$?
      |     if [ "$rc" -eq 0 ]; then changed=1; installed=("${tp_missing[@]}"); fi
      |   fi
      | fi
      merged from base #1, web #5, monitoring #9
  #2 file as shell:root reads [] writes [file:/etc/motd] post [file:/etc/motd=Exists(true)]
      | rc=0; changed=0
      | tp_p='/etc/motd'
      | if [ -d "$tp_p" ]; then echo "telepatch: $tp_p is a directory" >&2; rc=1; fi
      | tp_b='aGk='
      | if [ "$rc" -eq 0 ] && ! { [ -f "$tp_p" ] && [ "$(printf %s "$tp_b" | base64 -d | sha256sum | cut -d' ' -f1)" = "$(sha256sum < "$tp_p" | cut -d' ' -f1)" ]; }; then
      |   tp_t=$(mktemp "$tp_p.tpXXXXXX") || rc=$?
      |   if [ "$rc" -eq 0 ]; then
      |     if printf %s "$tp_b" | base64 -d > "$tp_t"; then
      |       if [ -e "$tp_p" ]; then
      |         chmod --reference="$tp_p" "$tp_t"; chown --reference="$tp_p" "$tp_t" 2>/dev/null
      |       else
      |         chmod 644 "$tp_t"
      |       fi
      |       mv -f "$tp_t" "$tp_p"; rc=$?
      |     else
      |       rc=$?
      |     fi
      |     if [ "$rc" -eq 0 ]; then changed=1; else rm -f "$tp_t"; fi
      |   fi
      | fi
role web
  #6 sh as shell:root reads [] writes [file:/var/log/nginx-test]
      | rc=0; changed=0; skipped=0
      | nginx -t
      | rc=$?
      | if [ "$rc" -eq 0 ]; then changed=1; fi

warning: sh! in a role body at crates/telepatch/tests/adversarial/merge_roles.rs:16
