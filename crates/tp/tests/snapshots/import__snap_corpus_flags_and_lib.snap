//! Distro flags of `inventories/group_vars/all`, generated by `tp import`.

use telepatch::facts::os::{Distro, Family, Os};

/// `inventories/group_vars/all:4`. Amazon is not in the list.
pub fn redhat_based(os: &Os) -> bool {
    os.family == Family::RedHat
        && match &os.distro {
            Distro::Fedora | Distro::Rocky | Distro::Alma => true,
            Distro::Other(id) => id == "centos" || id == "rhel",
            _ => false,
        }
}

/// `inventories/group_vars/all:5`. Tests the family (omarchy is Arch).
pub fn arch_based(os: &Os) -> bool {
    os.family == Family::Arch
}

/// `inventories/group_vars/all:6`. Tests the distribution, not the family.
pub fn debian_based(os: &Os) -> bool {
    matches!(os.distro, Distro::Debian | Distro::Ubuntu | Distro::PopOs)
}

/// `inventories/group_vars/all:7`. Debian 10.
pub fn debian10_based(os: &Os) -> bool {
    os.distro == Distro::Debian && os.version.major() == Some(10)
}

/// `inventories/group_vars/all:8`. Ubuntu and Pop!_OS.
pub fn ubuntu_based(os: &Os) -> bool {
    matches!(os.distro, Distro::Ubuntu | Distro::PopOs)
}

/// `inventories/group_vars/all:9`. Amazon Linux 2.
pub fn amazonlinux2_based(os: &Os) -> bool {
    os.distro == Distro::Amazon && os.version.major() == Some(2)
}

/// `inventories/group_vars/all:10`. Amazon Linux 2023.
pub fn amazonlinux2023_based(os: &Os) -> bool {
    os.distro == Distro::Amazon && os.version.major() == Some(2023)
}

/// `inventories/group_vars/all:11`. Ubuntu or Pop!_OS 20.04.
pub fn ubuntu2004_based(os: &Os) -> bool {
    ubuntu_based(os) && os.version.as_str() == "20.04"
}

/// `inventories/group_vars/all:12`. Ubuntu or Pop!_OS 22.04.
pub fn ubuntu2204_based(os: &Os) -> bool {
    ubuntu_based(os) && os.version.as_str() == "22.04"
}

/// `inventories/group_vars/all:13`. Ubuntu or Pop!_OS 24.04.
pub fn ubuntu2404_based(os: &Os) -> bool {
    ubuntu_based(os) && os.version.as_str() == "24.04"
}
